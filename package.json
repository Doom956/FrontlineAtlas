{
  "name": "frontline-atlas",
  "version": "1.0.0",
  "description": "Frontline Atlas: territory-control strategy game in the browser",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "vite-node --watch server/index.ts",
    "build": "vite build && npm run build:server",
    "build:checked": "npm run typecheck && npm run build",
    "build:client": "vite build",
    "build:server": "vite build --config server/vite.config.ts",
    "start": "node server-dist/index.js",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p server",
    "test": "vitest run",
    "headless": "vite-node scripts/headless.ts",
    "profile": "vite-node scripts/profile.ts"
  },
  "keywords": [],
  "author": "Doom956",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/ws": "8.18.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vite-node": "3.2.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "ws": "8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
